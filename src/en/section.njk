---
pagination:
  data: "sections"
  size: 1
  alias: "sectionEntry"
layout: "base.njk"
lang: "en"
eleventyComputed:
  permalink: "en/{{ sectionEntry.slug }}.html"
  # safe| ضرورية هنا: هذي قيم بيانات خام، وbase.njk هو اللي يهرّبها للـ HTML.
  # بدونها يُهرَّب الرمز & مرتين فيظهر "Bakeries &amp; Sweets" بتبويب المتصفح.
  title: "{{ sectionEntry.title_en | safe }} | Torilu"
  description: "{{ sectionEntry.description_en | safe }}"
  navActive: "{{ sectionEntry.slug }}"
  section: "{{ sectionEntry.slug }}"
  langSwitchUrl: "/{{ sectionEntry.slug }}.html"
---
{# قوالب المحتوى تُعرض قبل القالب الأب (base.njk)، فمتغيّر t المعرّف هناك مو
   متاح هنا — لازم كل قالب يحتاج t يعرّفه بنفسه #}
{% set t = i18n[lang or "ar"] %}
{% import "item-card.njk" as cards %}
{% if sectionEntry.slug == "guides" %}
{# جريدة توريلو: المقالات صفحة أولى لجريدة، لا شبكة بطاقات #}
{% include "guides-front.njk" %}
{% else %}
<div class="breadcrumb"><a href="{{ '/en/index.html' | url }}">{{ t.nav_home }}</a> / {{ sectionEntry.title_en }}</div>
<section class="page-header">
  <h1>{{ sectionEntry.title_en }}</h1>
  <p>{{ sectionEntry.description_en }}</p>
  {% if sectionEntry.slug in ["restaurants", "cafes", "bakeries"] %}<p class="review-note">{{ t.review_note }} <a href="{{ '/en/about.html#reviews' | url }}">{{ t.review_note_link }}</a></p>{% endif %}
</section>

{% if sectionEntry.slug == "car-shops" %}
<div class="hub-grid">
{%- for type in carShopTypes %}
{%- if collections['car-shops'] | carShopCount(type.label) %}
  <a class="hub-card" href="{{ ('/en/car-shops/' + type.slug + '.html') | url }}">
    <h2 class="hub-card-label">{{ type.label_en }}</h2>
  </a>
{%- endif %}
{%- endfor %}
</div>
{% else %}
<input type="text" class="search-box" placeholder="{{ sectionEntry.searchPlaceholder_en }}" aria-label="Search {{ sectionEntry.title_en }}" />
<button type="button" class="near-me-btn" aria-pressed="false">{{ t.near_me }}</button>
<div class="filters"></div>

{# البطاقات مطبوعة هنا وقت البناء عشان محركات البحث تقرأ المحتوى فعلاً #}
<h2 class="sr-only">{{ sectionEntry.title_en }} list</h2>
<div class="card-grid">
{%- for entry in collections[sectionEntry.slug] %}
{{ cards.card(entry, sectionEntry.slug, "en", sectionEntry.hasDetailPages, tags_en, i18n, tag_icons, loop.index0) }}
{%- endfor %}
</div>
{% endif %}
{% endif %}
