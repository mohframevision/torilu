{#- جريدة توريلو: صفحة المقالات صفحة أولى لجريدة ورق — نفس ورقة المقال (.np-sheet) وترويستها،
    ثم أحدث مقال خبراً رئيسياً بعنوان بعرض الصفحة، والباقي موجزات بأعمدة بينها خطوط.
    قائمة ثابتة بالـHTML (لمحركات البحث)، وليست .card-grid فلا يعيد main.js رسمها. -#}
{% from "newspaper.njk" import npDate %}
{% set isEn = lang == "en" %}
{% set articles = collections.guides | sort(true, false, "data.dateAdded") %}
<div class="breadcrumb"><a href="{{ ('/en/index.html' if isEn else '/index.html') | url }}">{{ t.nav_home }}</a> / {{ sectionEntry.title_en if isEn else sectionEntry.title }}</div>
<div class="np-sheet np-front">
<h1 class="sr-only">{{ sectionEntry.title_en if isEn else sectionEntry.title }}</h1>
<div class="np-mast" aria-hidden="true">
  <div class="np-mast-row"><span>{{ "Bahrain" if isEn else "البحرين" }}</span>{% if articles.length %}<span>{{ npDate(articles[0].data.dateAdded, lang) }}</span>{% endif %}<span>{{ "Articles" if isEn else "مقالات" }}</span></div>
  <p class="np-mast-name">{{ "Torilu" if isEn else "توريلو" }}<i>.</i></p>
  <div class="np-mast-row"><span>{{ sectionEntry.description_en if isEn else sectionEntry.description }}</span></div>
</div>
{% for entry in articles %}
{%- set d = entry.data %}
{%- set cat = (d.categories or [])[0] %}
{%- set href = (('/en/guides/' + (d.slug_en or entry.fileSlug)) if isEn else ('/guides/' + entry.fileSlug)) + '.html' %}
{%- set kicker %}{% if cat %}<span>{{ (tags_en[cat] or cat) if isEn else cat }}</span>{% endif %}{{ npDate(d.dateAdded, lang) }}{% endset %}
{%- if loop.first %}
<article class="np-lead">
  <p class="np-kicker">{{ kicker | safe }}</p>
  <h2 class="np-lead-title"><a href="{{ href | url }}">{{ (d.title_en or d.title) if isEn else d.title }}</a></h2>
  <div class="np-lead-cols">
    <div class="np-lead-text">
      <p class="np-lead-deck">{{ (d.desc_en or d.desc) if isEn else d.desc }}</p>
      <a class="np-more" href="{{ href | url }}">{{ "Read the article" if isEn else "اقرأ المقال" }}</a>
    </div>
    {#- القمر نقاط طباعة = شعار توريلو المعتمد «د» نفسه -#}
    <figure class="np-lead-art" aria-hidden="true"><img src="{{ '/assets/icon-square.svg' | url }}" alt="" width="512" height="512" /></figure>
  </div>
</article>
{%- if articles.length > 1 %}
<h2 class="np-briefs-head">{{ "More articles" if isEn else "مقالات أخرى" }}</h2>
<div class="np-briefs">
{%- endif %}
{%- else %}
  <article class="np-brief">
    <p class="np-kicker">{{ kicker | safe }}</p>
    <h3><a href="{{ href | url }}">{{ (d.title_en or d.title) if isEn else d.title }}</a></h3>
    <p>{{ (d.desc_en or d.desc) if isEn else d.desc }}</p>
  </article>
{%- endif %}
{%- if loop.last and articles.length > 1 %}
</div>
{%- endif %}
{% endfor %}
</div>
