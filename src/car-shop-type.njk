---
pagination:
  data: "carShopTypes"
  size: 1
  alias: "shopType"
layout: "base.njk"
eleventyComputed:
  permalink: "car-shops/{{ shopType.slug }}.html"
  title: "{{ shopType.label | safe }} — محلات السيارات | توريلو"
  description: "دليل {{ shopType.label | safe }} السيارات في البحرين، مع فلترة حسب المنطقة."
  navActive: "car-shops"
  section: "car-shops"
  typeFilter: "{{ shopType.label | safe }}"
  noindex: "{{ '' if (collections['car-shops'] | carShopCount(shopType.label)) else 'noindex' }}"
  langSwitchUrl: "/en/car-shops/{{ shopType.slug }}.html"
---
{# قوالب المحتوى تُعرض قبل القالب الأب (base.njk)، فمتغيّر t المعرّف هناك مو
   متاح هنا — لازم كل قالب يحتاج t يعرّفه بنفسه #}
{% set t = i18n[lang or "ar"] %}
{% import "item-card.njk" as cards %}
<div class="breadcrumb">
  <a href="{{ '/index.html' | url }}">{{ t.nav_home }}</a> /
  <a href="{{ '/car-shops.html' | url }}">محلات السيارات</a> /
  {{ shopType.label }}
</div>
<section class="page-header">
  <h1>{{ shopType.label }}</h1>
  <p class="type-tip">{{ shopType.tip }}</p>
</section>

<input type="text" class="search-box" placeholder="ابحث بين محلات {{ shopType.label }}…" aria-label="البحث في {{ shopType.label }}" />
<button type="button" class="near-me-btn" aria-pressed="false">{{ t.near_me }}</button>
{%- set shown = [] %}
{%- for entry in (collections['car-shops'] or []) %}{% if shopType.label in (entry.data.categories or []).concat(entry.data.categoriesCustom or []) %}{% set shown = (shown.push(entry), shown) %}{% endif %}{% endfor %}
{#- بلا محلات: الفلاتر رقاقة «الكل» وحدها، فيُحجز لها صف واحد (style.css) -#}
<div class="filters{% if not shown.length %} filters-one-row{% endif %}"></div>

{# البطاقات مطبوعة هنا وقت البناء عشان محركات البحث تقرأ المحتوى فعلاً.
   main.js يتبنّاها كما هي ويفلترها بنفس النوع (typeFilter أعلاه). #}
<h2 class="sr-only">قائمة محلات {{ shopType.label }}</h2>
<div class="card-grid">
{%- for entry in shown %}
{{ cards.card(entry, "car-shops", "ar", false, tags_en, i18n, tag_icons, loop.index0, true) }}
{%- endfor %}
</div>

{# إعلان كازاسوق (ألعاب) انشال من الدليل المحلي: ما يناسب نيّة زائر المطاعم والمحلات #}
