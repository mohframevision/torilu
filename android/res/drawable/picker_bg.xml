<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية "اختار لي": تدرّج أزرق الحبر من شبه أسود فوق لأزرق عميق تحت، مع
     توهّج أزرق ناعم من أسفل الوسط (نفس تكوين Recollect بهويتنا بدل البنفسجي) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF070B16" android:centerColor="#FF0E1A36" android:endColor="#FF173A86" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0.92" android:gradientRadius="420dp"
                android:startColor="#6681AAF7" android:endColor="#0081AAF7" />
        </shape>
    </item>
</layer-list>
