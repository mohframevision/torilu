<!-- شكل «د» (نفس رموز الموقع بـstyle.css): أزرق الحبر على ورق دافئ.
     brand_primary = خلفية ممتلئة عليها نص أبيض (أزرار، الرقاقة النشطة)،
     brand_accent = الأزرق كنص/أيقونة (السطر الصغير فوق الاسم، الروابط). -->
<resources>
    <color name="brand_primary">#1545A2</color>
    <color name="brand_accent">#1545A2</color>
    <color name="bg">#FAF6EF</color>
    <color name="surface">#FFFDFA</color>
    <color name="text">#1A1F29</color>
    <color name="text_muted">#5D646F</color>
    <color name="border">#DEDAD2</color>
    <!-- خطوط الجريدة (الخط المزدوج فوق عناوين الأقسام) بلون الحبر -->
    <color name="ink_rule">#1A1F29</color>
    <color name="white">#FFFFFF</color>
    <color name="secondary_btn_bg">#00000000</color>
    <color name="ripple_on_primary">#33FFFFFF</color>
    <color name="ripple_on_secondary">#141545A2</color>
    <color name="search_box_bg">#FFFDFA</color>
    <!-- أزرق ناعم (color-primary-soft بالموقع): مؤشر التبويب النشط وخلفية رسم مكان الأسبوع -->
    <color name="tonal">#DBE9FF</color>
    <color name="on_tonal">#1545A2</color>
    <!-- سطح غائر محايد (color-sunk بالموقع) للحقول والدوائر الثانوية -->
    <color name="field">#F0ECE4</color>
